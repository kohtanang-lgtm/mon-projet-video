  "groups": [
    {
      "index": 0,
      "text": "L'avenir se construit avec ceux qui osent",
      "start": 0.05,
      "end": 1.72,
      "syllablesPerSecond": 6.77
    },
    {
      "index": 1,
      "text": "voir plus grand.",
      "start": 1.83,
      "end": 2.795,
      "syllablesPerSecond": 3.58
    },
    {
      "index": 2,
      "text": "Et si la banque devenait enfin le reflet de vos ambitions ?",
      "start": 3.23,
      "end": 6.04,
      "syllablesPerSecond": 6.67
    },
    {
      "index": 3,
      "text": "Particuliers, familles, bâtisseurs du quotidien...",
      "start": 6.42,
      "end": 9.18,
      "syllablesPerSecond": 4.98
    },
    {
      "index": 4,
      "text": "UBA Tchad vous accompagne avec des solutions bancaires de proximité,",
      "start": 9.525,
      "end": 12.89,
      "syllablesPerSecond": 6.55
    },
    {
      "index": 5,
      "text": "des comptes adaptés à votre style de vie",
      "start": 13.155,
      "end": 15.125,
      "syllablesPerSecond": 5.38
    },
    {
      "index": 6,
      "text": "et des cartes sécurisées pour chaque instant.",
      "start": 15.235,
      "end": 17.275,
      "syllablesPerSecond": 6.1
    },
    {
      "index": 7,
      "text": "Plus besoin d'attendre.",
      "start": 17.61,
      "end": 18.585,
      "syllablesPerSecond": 5.59
    },
    {
      "index": 8,
      "text": "Prenez le contrôle de votre argent du bout des doigts.",
      "start": 18.8,
      "end": 20.915,
      "syllablesPerSecond": 6.1
    },
    {
      "index": 9,
      "text": "Ouvrez votre compte en ligne en quelques minutes,",
      "start": 21.2,
      "end": 23.27,
      "syllablesPerSecond": 5.68
    },
    {
      "index": 10,
      "text": "consultez vos soldes en temps réel et laissez Léo, votre banquier virtuel, simplifier vos paiements et transferts 24h/24.",
      "start": 23.41,
      "end": 30.24,
      "syllablesPerSecond": 4.97
    },
    {
      "index": 11,
      "text": "Entrepreneurs,",
      "start": 30.585,
      "end": 31.42,
      "syllablesPerSecond": 5.33
    },
    {
      "index": 12,
      "text": "PME, grandes organisations :",
      "start": 31.54,
      "end": 33.17,
      "syllablesPerSecond": 5.89
    },
    {
      "index": 13,
      "text": "propulsez votre activité vers de nouveaux sommets grâce à notre expertise en Corporate Banking et nos solutions de financement sur-mesure.",
      "start": 33.45,
      "end": 40.085,
      "syllablesPerSecond": 6.19
    },
    {
      "index": 14,
      "text": "UBA Tchad,",
      "start": 40.505,
      "end": 41.34,
      "syllablesPerSecond": 4.97
    },
    {
      "index": 15,
      "text": "la banque globale de l'Afrique.",
      "start": 41.515,
      "end": 43.13,
      "syllablesPerSecond": 5.85
    },
    {
      "index": 16,
      "text": "Rejoignez-nous dès aujourd'hui sur ubachad.com.",
      "start": 43.405,
      "end": 46.26,
      "syllablesPerSecond": 5.01
    }
  ],
